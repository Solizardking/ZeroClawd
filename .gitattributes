# Auto detect text files and perform LF normalization
* text=auto

*.go text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

pnpm-lock.yaml linguist-generated=true
**/package-lock.json linguist-generated=true
dist/** linguist-generated=true
**/dist/** linguist-generated=true
